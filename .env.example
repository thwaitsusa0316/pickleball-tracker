# Local Vite: copy to .env.local
# Railway: set the same names on the web service → Variables (read at container start into /config.json).
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Optional aliases (Railway runtime also accepts these):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
